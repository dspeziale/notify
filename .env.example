# ==============================================================================
# Multi-Application Notification Gateway - Environment Configuration
# ==============================================================================

# General Environment
PROJECT_NAME="Multi-Application Notification Gateway"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG="false"
API_V1_PREFIX="/api/v1"
GATEWAY_PORT=8080

# Database Configuration (PostgreSQL in production, SQLite for local testing)
# Example PostgreSQL: postgresql+asyncpg://gateway_user:gateway_secret_pass@localhost:5432/notification_gateway
# Example SQLite: sqlite+aiosqlite:///./notification_gateway.db
DATABASE_URL="postgresql+asyncpg://gateway_user:gateway_secret_pass@localhost:5432/notification_gateway"

# External Host Port mappings for Docker Compose (useful when 5432 or 6379 are already occupied on host)
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Redis Cache & Sliding-Window Rate Limiting
REDIS_ENABLED="true"
REDIS_URL="redis://localhost:6379/0"

# Cryptography & Security (AES-256-GCM)
# Generate a new 32-byte URL-safe base64 key with:
# python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY="CHANGE_ME_GENERATE_32_BYTES_URLSAFE_BASE64_KEY_HERE="
ACTIVE_KEY_VERSION="v1"

# Key Rotation Ring (JSON string mapping version tag to base64 key)
# Example: KEY_ROTATION_RING='{"v1": "old_key_base64...", "v2": "new_key_base64..."}'
KEY_ROTATION_RING='{}'

# API Key Hashing Pepper (Secret key used in HMAC-SHA256)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_PEPPER="CHANGE_ME_GENERATE_RANDOM_SECRET_PEPPER_HEX_HERE"

# Administrator Bootstrap Key (Used for /api/v1/admin/* management)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY="CHANGE_ME_GENERATE_STRONG_ADMIN_KEY_HERE"

# Rate Limiting
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# Notification Policies & Timeouts
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_FACTOR=1.5
NOTIFICATION_TIMEOUT_SECONDS=15.0
MAX_ATTACHMENT_SIZE_BYTES=10485760 # 10 Megabytes

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS='["*"]'

# Google OAuth2 Redirect URI (Must match Google Cloud Console OAuth Authorized Redirect URI)
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8080/api/v1/admin/gmail/oauth/callback"

# ==============================================================================
# Telegram Bot Integration (Set your BotFather token and chat ID here)
# ==============================================================================
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID_HERE"

# ==============================================================================
# Gmail / Email Integration (Google Password per le applicazioni / App Password)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="YOUR_EMAIL@gmail.com"
SMTP_PASSWORD="YOUR_16_DIGIT_APP_PASSWORD"
TEST_EMAIL_RECIPIENT="YOUR_EMAIL@gmail.com"

